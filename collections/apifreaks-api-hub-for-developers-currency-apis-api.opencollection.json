{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apifreaks Api Hub For Developers Currency APIs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-apiKey",
      "value": "{{X-apiKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Currency APIs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Convert currency with latest rates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apifreaks.com/v1.0/currency/converter/latest/prices",
            "params": [
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format: `json` (default) or `xml`."
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Source currency code."
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "Target currency code."
              },
              {
                "name": "amount",
                "value": "",
                "type": "query",
                "description": "Amount to convert, as a decimal. Defaults to `1`. Must be numeric — non-numeric values return a 400 (negative values are accepted despite the error message's wording)."
              },
              {
                "name": "updates",
                "value": "",
                "type": "query",
                "description": "Update frequency: `1m` (default), `10m`, `1h`, or `1d`."
              }
            ]
          },
          "docs": "Converts an amount from one currency to another using the latest exchange rates."
        },
        {
          "info": {
            "name": "Get exchange rate fluctuations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apifreaks.com/v1.0/currency/fluctuation",
            "params": [
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format: `json` (default) or `xml`."
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Start date in `YYYY-MM-DD` format."
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "End date in `YYYY-MM-DD` format. Defaults to yesterday."
              },
              {
                "name": "base",
                "value": "",
                "type": "query",
                "description": "Base currency code. Defaults to `USD`."
              },
              {
                "name": "symbols",
                "value": "",
                "type": "query",
                "description": "Comma-separated currency codes. Omit to get all available rates."
              }
            ]
          },
          "docs": "Returns exchange rate fluctuations between two dates for the requested symbols."
        },
        {
          "info": {
