      "item": [
        {
          "id": "b0422166-465f-473a-8a5c-b98b34f78cfc",
          "name": "Retrieve a country or organization flag image",
          "request": {
            "name": "Retrieve a country or organization flag image",
            "description": {
              "content": "Returns a flag image for a specified country or international organization. Supports PNG, WEBP, and SVG formats with flat or round shapes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "flags"
              ],
              "host": [
                "{{flags-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) Country code in ISO 3166-1 alpha-2 format for country flags, or organization identifier for organization flags. Organization identifiers are case-sensitive and must exactly match an entry from the Supported Flags endpoint (e.g. NATO, European_Union) — lowercase or abbreviated forms return a 404."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "(Required) Type of flag to retrieve. Possible values: country, organization."
                },
                {
                  "disabled": false,
                  "key": "shape",
                  "value": "<string>",
                  "description": "(Required) Shape of the flag image. Possible values: flat, round."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "png",
                  "description": "Image format. Possible values: png, webp, svg. Default: png."
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "<string>",
                  "description": "Size of the flag image in pixels. Possible values: 16px, 24px, 32px, 48px, 64px. Default is 64px when omitted. Applies to PNG and WEBP formats only; silently ignored (no error) when format is svg, since SVG is vector-scalable."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "33bd2ef8-60e6-4e00-9c63-172abe3ccc7f",
              "name": "Successful response with the flag image as raw binary data (not JSON) in the format requested",
