          "name": "Bulk validate phone numbers",
          "request": {
            "name": "Bulk validate phone numbers",
            "description": {
              "content": "Validates up to 100 phone numbers in a single request. Each number is processed independently — invalid entries return per-number errors without affecting the rest of the batch.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "phone",
                "validation",
                "bulk"
              ],
              "host": [
                "{{phone-validation-bulk-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Specifies the desired format for the API response. Choose 'json' for a JSON object. If not provided, the API defaults to JSON format."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numbers\": [\n    {\n      \"number\": \"<string>\",\n      \"region\": \"<string>\",\n      \"dialer_region\": \"<string>\"\n    },\n    {\n      \"number\": \"<string>\",\n      \"region\": \"<string>\",\n      \"dialer_region\": \"<string>\"\n    }\n  ]\n}",
